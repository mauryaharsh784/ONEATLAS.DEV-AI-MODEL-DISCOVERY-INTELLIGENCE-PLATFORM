# ───────────────────────── OneAtlas environment ─────────────────────────
# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Only NEXT_PUBLIC_* variables are exposed to the browser.

# ── Database (PostgreSQL / Neon) ──
# Runtime connection. On Neon use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://oneatlas:oneatlas_dev_password@127.0.0.1:5432/oneatlas?schema=public"
# Migrations connection. On Neon use the DIRECT (non-pooled) string. Optional locally.
DIRECT_URL=""
# Max connections per server instance. Keep 1–3 on Vercel/Neon, 10 locally.
DATABASE_POOL_MAX="10"

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Authentication (Auth.js) — wired in Phase 6 ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Playground provider keys (server-side only) — wired in Phase 5 ──
# Leave empty to run the playground in clearly-labelled demo mode.
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
